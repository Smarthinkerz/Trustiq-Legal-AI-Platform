# TrustiqLegal – environment variables
# Copy to .env for local development. In production set these in your host's dashboard.

# --- Required in production ---
NODE_ENV=development
# Public URL of the app (used in email links and origin checks)
APP_URL=http://localhost:8080
# PostgreSQL connection string. Leave empty locally to use the embedded database.
DATABASE_URL=
# Set to true if your provider requires TLS without a CA bundle (most managed Postgres do)
# DATABASE_SSL=true
# Optional: persist the embedded dev database between restarts
# PGLITE_DATA_DIR=.data/pglite

# --- AI (OpenAI or any OpenAI-compatible endpoint) ---
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1
# OPENAI_BASE_URL=https://api.openai.com/v1
# AI_TIMEOUT_MS=90000

# Hybrid law-library retrieval (optional; without these the library is searched with BM25 only).
# EMBEDDINGS_URL=https://embeddings.example.com/v1   # OpenAI-compatible /embeddings serving BAAI/bge-m3
# EMBEDDINGS_API_KEY=
# EMBEDDINGS_MODEL=BAAI/bge-m3                       # or intfloat/multilingual-e5-large
# VECTOR_INDEX_MAX_CHUNKS=150000
# RERANK_URL=https://rerank.example.com/v1           # Cohere-compatible /rerank serving BAAI/bge-reranker-v2-m3
# RERANK_API_KEY=
# RERANK_MODEL=BAAI/bge-reranker-v2-m3

# --- Email (invitations, password resets) ---
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM="TrustiqLegal <no-reply@trustiqlegal.com>"

# --- Online subscription payments (Tap Payments, https://tap.company) ---
# Secret key from the Tap dashboard (sk_live_… / sk_test_…). When set, owners can pay for plans online.
# TAP_SECRET_KEY=
# Signing secret for webhooks. Configure the Tap webhook URL as ${APP_URL}/webhooks/tap
# TAP_WEBHOOK_SECRET=
# TAP_API_URL=https://api.tap.company/v2
# TAP_WEBHOOK_TOLERANCE_MS=300000
# WEBHOOK_AUDIT_RETENTION_DAYS=90
# VAT added to subscription charges (e.g. 5 once VAT-registered in Oman)
# PLATFORM_VAT_PERCENT=0

# --- Law library importer ---
# Built in: GCC government domains (*.gov.om, *.gov.ae, *.gov.sa, *.gov.qa, *.gov.bh, *.gov.kw), almeezan.qa, difc.ae, adgm.com.
# Add more official sources, comma-separated:
# LIBRARY_IMPORT_DOMAINS=example-legislation.org
# Extra CA certificates (PEM, several allowed) trusted ONLY for library imports, e.g. when a government
# site's certificate comes from a national PKI that servers do not trust by default:
# LIBRARY_IMPORT_EXTRA_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

# --- Business ---
# SALES_EMAIL=sales@trustiqlegal.com
# SUPPORT_EMAIL=support@trustiqlegal.com
# Comma-separated emails that can access the platform admin console (/app#/admin)
PLATFORM_ADMIN_EMAILS=

# --- Operations ---
# PORT=8080
# TRUST_PROXY=true        # defaults to true in production; set false if not behind a proxy
# MAX_UPLOAD_MB=15
# PLATFORM_BLOG_SLUG=          # firm website slug whose published articles appear on the TrustiqLegal blog (/blog); default: the platform admins' firm
# MAX_VIDEO_MB=50          # largest video a firm can upload into a blog article
# OPENAI_IMAGE_MODEL=gpt-image-1   # AI cover images for the firm blog (or dall-e-3)
# OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe   # speech-to-text for voice notes on cases (or whisper-1)
# LOG_LEVEL=info

# Google Calendar sync (redirect URI: <APP_URL>/api/integrations/google/callback)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Key for encrypting stored OAuth tokens and firms' Tap keys for invoice payments (falls back to GOOGLE_CLIENT_SECRET, then TAP_SECRET_KEY).
# Set it to a long random value before firms connect Tap; changing it later means they reconnect.
# ENCRYPTION_KEY=

# File storage. "db" keeps uploaded files in PostgreSQL. "s3" sends new files to an S3-compatible
# object store (Oracle Cloud Object Storage, MinIO, Ceph, AWS), e.g. in an Oman data center.
# Move existing files with: npx tsx scripts/move-files.ts to-store
STORAGE_DRIVER=db
# S3_ENDPOINT=https://objectstorage.me-muscat-1.example.com
# S3_BUCKET=trustiq-files
# S3_REGION=me-muscat-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PREFIX=
