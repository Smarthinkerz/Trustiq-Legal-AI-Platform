{
  "name": "trustiqlegal-platform",
  "version": "1.0.0",
  "private": true,
  "description": "TrustiqLegal – bilingual, AI-assisted legal practice platform for GCC law firms",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "tailwindcss -i src/styles/app.css -o public/static/app.css --minify",
    "dev": "npm run build && tsx watch src/index.tsx",
    "dev:css": "tailwindcss -i src/styles/app.css -o public/static/app.css --watch",
    "start": "NODE_ENV=production tsx src/index.tsx",
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@fortawesome/fontawesome-free": "^7.3.1",
    "@hono/node-server": "^2.1.3",
    "@hono/zod-validator": "^0.9.1",
    "@tailwindcss/cli": "^4.3.3",
    "bcryptjs": "^3.0.3",
    "docx": "^9.8.1",
    "hono": "^4.13.11",
    "mammoth": "^1.13.0",
    "nodemailer": "^10.0.13",
    "pg": "^8.23.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "unpdf": "^1.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "pdf-lib": "^1.17.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.2"
  }
}
